# Template for one of our own checkpoints. Copy it, set NAME / OUT / CKPT_DIR / CKPT_LABEL, then run it as a single
# task first (TASKS=<task> SEEDS=0 PODS=1) and as the full protocol after (TASKS=all SEEDS="0 1 2" PODS=24).
# The checkpoint directory must already be on the volume and hold what the OpenWAM adapter loads:
# config.yaml, checkpoint_step_*.safetensors, normalization_stats.npy (and tokenizer/ when the config needs it).
NAME=my-ckpt
OUT=/workspace/oeh-campaign/fastestwam-eval/my-ckpt      # a new directory per checkpoint: launch.sh refuses to mix checkpoints in one OUT
CKPT_DIR=/workspace/oeh-campaign/checkpoints/my-ckpt
CKPT_LABEL=my-ckpt
POLICY_DIR=XPolicyLab/policy/OpenWAM
POLICY_ENV=/workspace/oeh-campaign/envs/openwam
RUN_PREFIX=fw
TASKS=stack_bowls
SEEDS="0"
EVAL_NUM=native
PAIR_RANDOM=1
PODS=1
DRIVERS="580.159.04"
MAX_CELL_HOURS=6
CLAIM_LIMIT=all
