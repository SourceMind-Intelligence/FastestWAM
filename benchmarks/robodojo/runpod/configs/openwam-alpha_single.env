# One task for the released OpenWAM-alpha checkpoint: 1 pod, seed 0, native episodes (~1-4 h, ~$1-5).
# Pick the task on the command line:  bash launch.sh configs/openwam-alpha_single.env TASKS=stack_bowls
# A Generalization task brings its _random sibling along (PAIR_RANDOM=1): both halves make the leaderboard's 50 episodes.
# Shares OUT with the full config, so a cell finished here is not run again by the full eval.
NAME=openwam-alpha
OUT=/workspace/oeh-campaign/fastestwam-baseline
CKPT_DIR=/workspace/oeh-campaign/checkpoints/OpenWAM-Alpha-Sim-RoboDojo
CKPT_LABEL=OpenWAM-Alpha-Sim-RoboDojo
POLICY_DIR=XPolicyLab/policy/OpenWAM
POLICY_ENV=/workspace/oeh-campaign/envs/openwam
RUN_PREFIX=fwbase
TASKS=put_bottles_into_dustbin
SEEDS="0"
EVAL_NUM=native
PAIR_RANDOM=1
PODS=1
DRIVERS="580.159.04"
MAX_CELL_HOURS=6
CLAIM_LIMIT=all
