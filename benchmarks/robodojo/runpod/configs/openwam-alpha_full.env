# Full RoboDojo protocol for the released OpenWAM-alpha checkpoint: 42 tasks (the 12 Generalization tasks with their
# _random siblings = 54 task dirs) x seeds 0,1,2 at native episode counts = 162 cells, ~196 L40S-hours, ~$215.
# Target: Avg SR 11.92 / Score 17.18 (assets/robodojo_verification/openwam_robodojo_per_seed.json).
NAME=openwam-alpha
OUT=/workspace/oeh-campaign/fastestwam-baseline          # results root on the volume; one checkpoint per OUT
CKPT_DIR=/workspace/oeh-campaign/checkpoints/OpenWAM-Alpha-Sim-RoboDojo   # config.yaml + checkpoint_step_*.safetensors + normalization_stats.npy
CKPT_LABEL=OpenWAM-Alpha-Sim-RoboDojo                    # goes into result paths (no slashes)
POLICY_DIR=XPolicyLab/policy/OpenWAM                     # relative to the RoboDojo checkout; its deploy.yml must say eval_batch: true
POLICY_ENV=/workspace/oeh-campaign/envs/openwam
RUN_PREFIX=fwbase                                        # run id = <RUN_PREFIX>_s<seed>; the same id resumes a half-finished cell
TASKS=all                                                # all | a dimension (generalization memory precision long-horizon open) | task names
SEEDS="0 1 2"
EVAL_NUM=native                                          # native = 50 per task, 25 per paired half; a number caps it (smoke runs)
PODS=24                                                  # pod count only sets the wall time (~196 h / PODS, floor ~4 h); cost stays ~flat
DRIVERS="580.159.04"                                     # drivers a pod may have; others are deleted unused. Add 580.173.02 to staff faster
MAX_CELL_HOURS=6                                         # a hung cell is killed after this; the longest cell took ~4.1 h in projection
CLAIM_LIMIT=all                                          # spend guard: cells that may be claimed in total under OUT (all = every cell of this launch)
